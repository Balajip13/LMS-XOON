## Client environment variables (copy to .env)
# For production, replace with your backend domain
VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com

# For local development (uncomment below if needed, though default fallback exists)
# VITE_API_URL=http://127.0.0.1:5000

# Google OAuth (public client id; still keep in env for flexibility)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

